[
  {
    "topic": "homeassistant/sensor/openqiara_14_battery/config",
    "payload": {
      "device": {
        "identifiers": [
          "openqiara_14"
        ],
        "manufacturer": "Qiara/Cofidur",
        "model": "HOMELABDWS",
        "name": "OpenQiara DWS 14",
        "via_device": "openqiara_camera"
      },
      "device_class": "battery",
      "json_attributes_topic": "openqiara/sensor/14/state",
      "name": "Batterie",
      "state_topic": "openqiara/sensor/14/state",
      "unique_id": "openqiara_dws_14_battery",
      "unit_of_measurement": "%",
      "value_template": "{{ value_json.battery }}"
    }
  },
  {
    "topic": "homeassistant/sensor/openqiara_14_temperature/config",
    "payload": {
      "device": {
        "identifiers": [
          "openqiara_14"
        ],
        "manufacturer": "Qiara/Cofidur",
        "model": "HOMELABDWS",
        "name": "OpenQiara DWS 14",
        "via_device": "openqiara_camera"
      },
      "device_class": "temperature",
      "json_attributes_topic": "openqiara/sensor/14/state",
      "name": "Température",
      "state_topic": "openqiara/sensor/14/state",
      "unique_id": "openqiara_dws_14_temperature",
      "unit_of_measurement": "°C",
      "value_template": "{{ value_json.temperature if value_json.temperature is defined else None }}"
    }
  }
]
